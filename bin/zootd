#!/usr/bin/env bash
set -Eeuo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
maa="${project_root}/bin/zootd-maa"
planner="${project_root}/bin/zootd-planner"
advisor_adapter="${project_root}/bin/zootd-codex-advisor"
supervisor_adapter="${project_root}/bin/zootd-codex-supervisor"
recovery_adapter="${project_root}/bin/zootd-codex-recovery"
daily_launcher="${project_root}/scripts/run-daily.sh"
runtime_updater="${project_root}/scripts/update-maa-runtime.sh"
host_config="${project_root}/config/host.env"
local_config="${project_root}/config/host.local.env"

# Managed runs and doctor must validate and execute the same task directory.
export MAA_CONFIG_DIR="${project_root}/config"
export MAA_DATA_DIR="${MAA_DATA_DIR:-${project_root}/var/data}"
export MAA_CACHE_DIR="${MAA_CACHE_DIR:-${MAA_DATA_DIR}/cache}"
export MAA_STATE_DIR="${MAA_STATE_DIR:-${project_root}/var/state}"

if [[ -r "${host_config}" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "${host_config}"
    set +a
fi
if [[ -r "${local_config}" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "${local_config}"
    set +a
fi

# Reassert after host.local.env so managed runs cannot redirect the validated
# task, core/resource, hot-cache, or evidence directories.
export MAA_CONFIG_DIR="${project_root}/config"
export MAA_DATA_DIR="${project_root}/var/data"
export MAA_CACHE_DIR="${MAA_DATA_DIR}/cache"
export MAA_STATE_DIR="${project_root}/var/state"

: "${MAA_HOST_PROFILE:=waydroid}"
: "${MAA_HOST_TASK:=daily}"
: "${MAA_HOST_CLEANUP_ON_FAILURE:=true}"
: "${MAA_LOG:=info}"
export MAA_LOG

info() {
    printf '[zootd] %s\n' "$*"
}

die() {
    printf '[zootd] error: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

import_desktop_environment() {
    local key value

    command -v systemctl >/dev/null 2>&1 || return 0
    while IFS='=' read -r key value; do
        case "${key}" in
            DBUS_SESSION_BUS_ADDRESS|DISPLAY|WAYLAND_DISPLAY|XDG_CURRENT_DESKTOP|XDG_RUNTIME_DIR|XDG_SESSION_TYPE)
                if [[ -n "${value}" ]]; then
                    printf -v "${key}" '%s' "${value}"
                    export "${key}"
                fi
                ;;
        esac
    done < <(systemctl --user show-environment 2>/dev/null || true)
}

check_wayland() {
    local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    [[ -n "${WAYLAND_DISPLAY:-}" ]] || die "WAYLAND_DISPLAY is unavailable; log in to the Wayland desktop first"
    [[ -S "${runtime_dir}/${WAYLAND_DISPLAY}" ]] || die "Wayland socket is unavailable: ${runtime_dir}/${WAYLAND_DISPLAY}"
}

waydroid_session_is_running() {
    waydroid status 2>/dev/null | grep -Eq '^Session:[[:space:]]+RUNNING$'
}

probe_device() {
    local address adb_state packages
    local official_package=com.hypergryph.arknights

    if ! waydroid_session_is_running; then
        printf '[zootd] live probe needs a running Waydroid session\n' >&2
        printf '[zootd] open it with: waydroid show-full-ui\n' >&2
        return 1
    fi

    waydroid adb connect || return 1
    address="$(waydroid status | awk '/^IP address:/ { print $3 ":5555"; exit }')"
    [[ -n "${address}" ]] || {
        printf '[zootd] Waydroid did not report an IP address\n' >&2
        return 1
    }

    adb_state="$(adb devices | awk -v serial="${address}" '$1 == serial { print $2; exit }')"
    case "${adb_state}" in
        device)
            info "ADB is authorized: ${address}"
            ;;
        unauthorized)
            printf '[zootd] ADB is unauthorized; accept the debugging dialog in Waydroid and select Always allow\n' >&2
            return 1
            ;;
        *)
            printf '[zootd] ADB device is not ready: %s (%s)\n' "${address}" "${adb_state:-missing}" >&2
            return 1
            ;;
    esac

    packages="$(waydroid app list)"
    if grep -Fq "packageName: ${official_package}" <<<"${packages}"; then
        info "found official CN Arknights package: ${official_package}"
        return 0
    fi

    printf '[zootd] official CN Arknights package is not installed: %s\n' \
        "${official_package}" >&2
    return 1
}

run_raw_task() {
    local task="${1:-${MAA_HOST_TASK}}"
    local profile="${2:-${MAA_HOST_PROFILE}}"
    local lock_dir="${project_root}/var/run"
    local log_dir="${MAA_STATE_DIR}/host"
    local log_file status session_was_running=false

    require_command adb
    require_command flock
    require_command waydroid
    [[ -x "${maa}" ]] || die "MAA wrapper is not executable: ${maa}"

    import_desktop_environment
    check_wayland
    mkdir -p -- "${lock_dir}" "${log_dir}"

    exec 9>"${lock_dir}/zootd.lock"
    flock -n 9 || die "another zootd run is already active"

    if waydroid_session_is_running; then
        session_was_running=true
    fi

    log_file="${log_dir}/$(date '+%Y%m%d-%H%M%S').log"
    info "running task=${task} profile=${profile}"
    info "MAA log: ${log_file}"

    set +e
    "${maa}" --batch --log-file="${log_file}" run "${task}" --profile "${profile}"
    status=$?
    set -e

    if (( status != 0 )); then
        if [[ "${MAA_HOST_CLEANUP_ON_FAILURE}" == true && "${session_was_running}" == false ]]; then
            info "run failed; stopping the Waydroid session started for this run"
            waydroid session stop >/dev/null 2>&1 || true
        fi
        die "task failed with status ${status}; inspect ${log_file}"
    fi

    info "task completed"
}

doctor() {
    local failed=0
    local sdk_python="${MAA_CODEX_SDK_PYTHON:-${project_root}/.venv/bin/python}"

    import_desktop_environment
    info "project: ${project_root}"

    for command_name in adb flock gamescope jq loginctl stat systemctl timeout waydroid; do
        if command -v "${command_name}" >/dev/null 2>&1; then
            info "found ${command_name}: $(command -v "${command_name}")"
        else
            printf '[zootd] missing: %s\n' "${command_name}" >&2
            failed=1
        fi
    done

    if [[ -x "${project_root}/.local/bin/maa" ]]; then
        "${maa}" version || failed=1
    else
        printf '[zootd] missing project-local maa-cli\n' >&2
        failed=1
    fi

    if [[ -x "${advisor_adapter}" ]]; then
        info "found read-only advisor adapter: ${advisor_adapter}"
    else
        printf '[zootd] advisor adapter is not executable: %s\n' \
            "${advisor_adapter}" >&2
        failed=1
    fi
    if [[ -x "${supervisor_adapter}" ]]; then
        info "found exception-only supervisor adapter: ${supervisor_adapter}"
    else
        printf '[zootd] supervisor adapter is not executable: %s\n' \
            "${supervisor_adapter}" >&2
        failed=1
    fi
    if [[ -x "${recovery_adapter}" ]]; then
        info "found unsandboxed recovery adapter: ${recovery_adapter}"
    else
        printf '[zootd] recovery adapter is not executable: %s\n' \
            "${recovery_adapter}" >&2
        failed=1
    fi
    if [[ -x "${sdk_python}" ]]; then
        PYTHONPATH="${project_root}" \
            "${sdk_python}" -m maa_planner.codex_sdk doctor || failed=1
    else
        printf '[zootd] Codex SDK environment is unavailable: %s; run scripts/bootstrap.sh\n' \
            "${sdk_python}" >&2
        failed=1
    fi

    waydroid status || failed=1

    if [[ -n "${WAYLAND_DISPLAY:-}" && -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY}" ]]; then
        info "Wayland socket is ready: ${WAYLAND_DISPLAY}"
    else
        info "no desktop Wayland socket is active; managed runs will use Gamescope headless"
    fi

    if [[ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" == yes ]]; then
        info "systemd user lingering is enabled for unattended timers"
    else
        printf '[zootd] systemd user lingering is disabled; run sudo loginctl enable-linger %s\n' \
            "$(id -un)" >&2
        failed=1
    fi

    if [[ -d "/usr/lib/modules/$(uname -r)" ]]; then
        info "running kernel has matching modules: $(uname -r)"
    else
        printf '[zootd] running kernel modules are unavailable for %s; reboot after the kernel upgrade\n' \
            "$(uname -r)" >&2
        failed=1
    fi

    if [[ -r /etc/docker/daemon.json ]] &&
       jq -e '."ip-forward-no-drop" == true' /etc/docker/daemon.json >/dev/null 2>&1; then
        info "Docker ip-forward-no-drop is configured"
    else
        printf '[zootd] persistent Docker forwarding config is missing; run sudo ./scripts/install-network-fix.sh\n' >&2
        failed=1
    fi

    if [[ -x "${planner}" ]]; then
        "${planner}" validate-service-readiness || failed=1
        jq -n -f "${project_root}/config/fight-decision.jq" >/dev/null || failed=1
        jq -n -f "${project_root}/config/annihilation-decision.jq" >/dev/null || failed=1
    else
        printf '[zootd] farming planner is not executable: %s\n' "${planner}" >&2
        failed=1
    fi

    if waydroid_session_is_running; then
        probe_device || failed=1
    else
        info "live ADB/package checks skipped while Waydroid is stopped"
    fi

    (( failed == 0 )) || die "doctor found one or more problems"
    info "doctor checks passed"
}

usage() {
    cat <<'EOF'
Usage: bin/zootd <command> [arguments]

Commands:
  run [options]         Run the unified daily launcher (automatic farming by default)
  raw-run [task] [profile]
                        Run one MAA task directly, without launcher orchestration
  doctor                Check dependencies and the promoted runtime receipt
  advisor-check         Run and archive one bounded real-model connectivity probe
  supervisor-check      Send one synthetic failure to the exception-only LLM supervisor
  recover RUN_ID [SLOT]
                        Recover a failed full audit; SLOT is manual (default),
                        evening, or morning
  runtime-update        Validate stable Core plus staged resources, then atomically promote them
  runtime-rollback      Validate and atomically restore the retained previous runtime
  resource-update       Compatibility alias for runtime-update
  probe                 Check live ADB authorization and the game package
  proxy-status --stage STAGE [--activity-instance ID]
                        Show the local proxy failure streak without playing
  proxy-reset --stage STAGE [--activity-instance ID]
                        Clear a local proxy mark after re-recording it in game
  install-core          Install the first validated stable runtime
  update                Alias for the transactional stable runtime update
  status                Show Waydroid and systemd timer status
  logs                  Follow logs from the user service
EOF
}

command_name="${1:-}"
case "${command_name}" in
    run)
        shift
        [[ -x "${daily_launcher}" ]] || die "daily launcher is not executable: ${daily_launcher}"
        exec "${daily_launcher}" "$@"
        ;;
    raw-run)
        shift
        run_raw_task "$@"
        ;;
    proxy-status|proxy-reset)
        shift
        exec "${planner}" "${command_name}" "$@"
        ;;
    doctor)
        doctor
        ;;
    advisor-check)
        shift
        exec "${planner}" advisor-check "$@"
        ;;
    supervisor-check)
        shift
        exec "${planner}" supervisor-check "$@"
        ;;
    recover)
        shift
        [[ -n "${1:-}" ]] || die "recover requires a failed supervisor run id"
        recovery_run_id="$1"
        recovery_slot="${2:-manual}"
        (( $# <= 2 )) || die "recover accepts only RUN_ID and optional SLOT"
        exec "${planner}" supervisor-recover-run --run-id "${recovery_run_id}" \
            --slot "${recovery_slot}"
        ;;
    runtime-update|resource-update)
        shift
        [[ -x "${runtime_updater}" ]] || die "runtime updater is not executable: ${runtime_updater}"
        exec "${runtime_updater}" "$@"
        ;;
    runtime-rollback)
        shift
        (( $# == 0 )) || die "runtime-rollback accepts no arguments"
        [[ -x "${runtime_updater}" ]] || die "runtime updater is not executable: ${runtime_updater}"
        exec "${runtime_updater}" --rollback
        ;;
    probe)
        import_desktop_environment
        probe_device
        ;;
    install-core)
        exec "${runtime_updater}"
        ;;
    update)
        exec "${runtime_updater}"
        ;;
    status)
        waydroid status
        systemctl --user status \
            zootd-codex-update.timer zootd-runtime-update.timer \
            zootd-prereset.timer zootd.timer --no-pager || true
        ;;
    logs)
        exec journalctl \
            --user-unit=zootd-codex-update.service \
            --user-unit=zootd-runtime-update.service \
            --user-unit=zootd-prereset.service \
            --user-unit=zootd.service --follow
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
