# Non-secret runtime defaults read by bin/maa-host.
MAA_HOST_PROFILE=waydroid
MAA_HOST_TASK=daily
MAA_FARM_MODE=auto
MAA_PURE_GOLD_DRONE_THRESHOLD=150
MAA_HOST_CLEANUP_ON_FAILURE=true
MAA_LOG=info
# Resolve Codex independently of an interactive shell's PATH. Authentication
# remains in the normal per-user CODEX_HOME under HOME.
MAA_CODEX_BIN="${HOME}/.local/bin/codex"
# auto uses the logged-in Hyprland desktop when present and a standard
# Gamescope headless backend for unattended timer runs.
MAA_WAYDROID_DISPLAY_MODE=auto
