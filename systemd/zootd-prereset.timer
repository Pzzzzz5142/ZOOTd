[Unit]
Description=Run the pre-reset ZOOTd task

[Timer]
# 02:00 still belongs to the game day that ends at 04:00 Asia/Shanghai.
OnCalendar=*-*-* 02:00:00 Asia/Shanghai
# The launcher also rejects suspend catch-up outside 02:00-02:04.
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=zootd-prereset.service

[Install]
WantedBy=timers.target
