[Unit]
Description=Run MAA through a managed Waydroid session
Documentation=https://github.com/MaaAssistantArknights/maa-cli
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/Projects/zootd/bin/zootd

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/zootd
ExecStart=%h/Projects/zootd/bin/zootd run --morning-slot
# Both slots allow 9h50m plus 4m cleanup. A scheduled 18:00 run ends before 04:00.
TimeoutStartSec=590m
TimeoutStopSec=4m
KillSignal=SIGINT
Nice=5
IOSchedulingClass=idle
