[Unit]
Description=Run MAA through a managed Waydroid session
Documentation=https://github.com/MaaAssistantArknights/maa-cli
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/Projects/zootd/bin/zootd

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/zootd
ExecStart=%h/Projects/zootd/bin/zootd run --post-reset-slot
# Complete daily + Annihilation/material planning + final Award-only phase.
TimeoutStartSec=10h
TimeoutStopSec=4m
KillSignal=SIGINT
Nice=5
IOSchedulingClass=idle
